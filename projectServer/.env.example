# 系统配置加密密钥（重要）
# 用于加密数据库存储的敏感配置（如 AI API Key）
# 请设置一个随机 32 位字符串，生产环境务必修改
# 不上传到代码仓库，只在服务器本地配置
CONFIG_ENCRYPT_KEY=change-this-to-a-random-32-char-string

# AI 对话接口配置（已迁移到数据库管理，本地开发可保留用于初始化）
# 默认使用 SiliconFlow 免费模型
AI_API_KEY=
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_MODEL=Qwen/Qwen2.5-7B-Instruct
